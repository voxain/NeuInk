# Manifest for src/components/icons/homeIcons.h: Lucide 1.70.0 (ISC), the icons of the apps and Home
# entries, the title bars, the status bar and the games' tool buttons.
#
# Only 24 and 48 px: Lucide is drawn on a 24-unit grid with 2-unit strokes, so at 24 px and at exactly
# twice that every stroke and gap falls on whole pixels. Other sizes smear them (uneven pillars/bars).
#
# The vendored SDK does not carry the Lucide SVGs: generate with the SVGs of Lucide (npm: lucide-static):
#   python3 freeink-sdk/libs/assets/Icons/tools/gen_icons.py --svgdir <lucide/icons> \
#     --manifest src/components/icons/homeIcons.manifest --sizes 24,48 --out src/components/icons/homeIcons.h
sudoku = grid-3x3
chess = chess-knight
checkers = disc-3
go = circle-dot
tictactoe = tic-tac-toe
clock = clock
highlights = highlighter
undo = undo-2
erase = eraser
notes = pencil
fill = paint-bucket
hint = lightbulb
flip = arrow-down-up
files = folder
library = landmark
opds = library-big
stats = chart-column
settings = settings
transfer_arrows = arrow-left-right
wifi_on = wifi
wifi_zero = wifi-zero
